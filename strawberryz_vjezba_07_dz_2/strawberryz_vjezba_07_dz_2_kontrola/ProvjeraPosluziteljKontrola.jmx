          <RegexExtractor guiclass="RegexExtractorGui" testclass="RegexExtractor" testname="Dohvati idUlaznice" enabled="true">
            <stringProp name="RegexExtractor.useHeaders">false</stringProp>
            <stringProp name="RegexExtractor.refname">idUlaznice</stringProp>
            <stringProp name="RegexExtractor.regex">OK\s+([a-zA-Z0-9]+)</stringProp>
            <stringProp name="RegexExtractor.template">$1$</stringProp>
            <stringProp name="RegexExtractor.default">0</stringProp>
            <boolProp name="RegexExtractor.default_empty_value">false</boolProp>
            <stringProp name="RegexExtractor.match_number">1</stringProp>
          </RegexExtractor>
