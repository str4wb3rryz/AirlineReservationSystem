          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">def idUlaznice = vars.get(&quot;idUlaznice&quot;)
if (idUlaznice != null &amp;&amp; !idUlaznice.isEmpty()) {
    props.put(&quot;idUlaznice&quot;, idUlaznice)
    log.info(&quot;postprocessor idUlaznice = &quot; + idUlaznice)
} else {
    log.error(&quot;RegexExtractor nije izvukao idUlaznice!&quot;)
}</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
