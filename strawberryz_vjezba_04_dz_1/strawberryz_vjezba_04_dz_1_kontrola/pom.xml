<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>edu.unizg.foi.nwtis.strawberryz</groupId>
    <artifactId>strawberryz_vjezba_04_dz_1</artifactId>
    <version>1.0.0</version>
  </parent>
  <artifactId>strawberryz_vjezba_04_dz_1_kontrola</artifactId>
  <name>strawberryz_vjezba_04_dz_1_kontrola</name>
  
  <dependencies>
  	<dependency>
  		<groupId>edu.unizg.foi.nwtis.strawberryz</groupId>
  		<artifactId>strawberryz_vjezba_04_dz_1_podaci</artifactId>
  		<version>1.0.0</version>
  	</dependency>
  	<dependency>
  		<groupId>edu.unizg.foi.nwtis.strawberryz</groupId>
  		<artifactId>strawberryz_vjezba_04_dz_1_konfiguracije</artifactId>
  		<version>1.1.0</version>
  	</dependency>
  </dependencies>

  <build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<version>${maven.dependency}</version>
				<executions>
					<execution>
						<id>copy-dependencies</id>
						<?m2e ignore?>
						<phase>package</phase>
						<goals>
							<goal>copy-dependencies</goal>
						</goals>
						<configuration>
							<outputDirectory>
								${project.build.directory}/libs
							</outputDirectory>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-assembly-plugin</artifactId>
				<version>${maven.assembly}</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>single</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<descriptorRefs>
						<descriptorRef>jar-with-dependencies</descriptorRef>
					</descriptorRefs>
					<archive>
						<manifest>
							<mainClass>edu.unizg.foi.nwtis.strawberryz.vjezba_04_dz_1.PosluziteljKontrola</mainClass>
						</manifest>
					</archive>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<version>${maven.jar}</version>
				<configuration>
					<archive>
						<manifest>
							<addClasspath>true</addClasspath>
							<classpathPrefix>libs/</classpathPrefix>
							<mainClass>edu.unizg.foi.nwtis.strawberryz.vjezba_04_dz_1.PosluziteljKontrola</mainClass>
						</manifest>
					</archive>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>